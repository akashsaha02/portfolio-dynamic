# Copy to .env.local and fill in. Never commit real values.
# Every variable the app reads is listed here with a comment.

# Public base URL of the site, used for metadataBase (canonical and Open Graph URLs).
# Defaults to http://localhost:3000 when unset. On Vercel set it to the production URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Which template renders the public site: "editorial" (legacy v1 design) or "folio".
# Defaults to "editorial". Read on the server; static pages pick it up at build time, so
# rebuild after changing it. An unknown value fails the build. Phase 3 moves this to the
# Payload site-settings global.
SITE_TEMPLATE=editorial
