# Copy to .env.local and fill in. Never commit real values.
# Every variable the app reads is listed here with a comment.

# Public base URL of the site, used for metadataBase (canonical and Open Graph URLs), see lib/seo.ts.
# Optional. When unset: on Vercel the system variables are used (production builds:
# https://$VERCEL_PROJECT_PRODUCTION_URL; previews: https://$VERCEL_URL); elsewhere
# http://localhost:$PORT (3000), and a production build prints a warning. An invalid URL fails the build.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Which template renders the public site. "folio" is the only template (the v1 "editorial"
# design was retired: git tag v1-editorial), and it is the default, so leave this unset.
# Only used when DATABASE_URI is unset (static content: local builds, CI, e2e). With a database the
# Payload site-settings global (`activeTemplate`) decides and this is ignored. Read at build time.
# "editorial" still builds (as folio, with a warning); any other unknown value fails the build.
# SITE_TEMPLATE=folio

# Optional, build time: output folder for next build/start (default .next). The e2e runner uses
# .next-folio so its build doesn't overwrite your dev/prod .next.
# NEXT_DIST_DIR=.next-folio

# --- Payload CMS (admin at /admin, work plan 2.2) ---

# Required. Signs admin session tokens. A long random string, different per environment, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs the admin out. Server only: never prefix with NEXT_PUBLIC_.
PAYLOAD_SECRET=

# MongoDB connection string. Required for the admin. It also switches the public site's source
# (lib/data.ts): unset = the static lib/content.ts; set = Payload, and an unreachable database then
# fails the build / the page render loudly instead of serving the static copy.
# Production: MongoDB Atlas free cluster (guide §9.2), e.g.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority
# Local development: run `npm run dev:db` (throwaway in-memory MongoDB) and paste the URI it prints.
DATABASE_URI=

# Optional. Vercel Blob read-write token for media uploads (guide §9.2). Vercel sets it when a Blob
# store is connected to the project. When unset, uploads go to ./media on local disk (git-ignored),
# which only works locally: Vercel's file system is read-only.
BLOB_READ_WRITE_TOKEN=

# --- Contact form (work plan 2.5, lib/actions/contact.ts) ---

# Cloudflare Turnstile secret key (guide §9, free). Server only: never prefix with NEXT_PUBLIC_.
# When unset, verification is skipped in development and `next dev`; in a production build
# (`next build` / `next start`, Vercel) the form fails closed with a friendly error.
# For local production builds and e2e, Cloudflare's test secret always passes:
#   1x0000000000000000000000000000000AA   (and 2x0000000000000000000000000000000AA always fails)
TURNSTILE_SECRET_KEY=

# Cloudflare Turnstile site key for the widget on the contact form (public by design; task 3.3).
# Test key that always passes: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Resend API key for the new-message notification email (guide §9, free: 100 emails/day).
# Sent from onboarding@resend.dev, which only delivers to the Resend account's own address.
# When unset (or CONTACT_TO_EMAIL is unset), messages are still saved to the admin inbox and the
# email is skipped with a log line.
RESEND_API_KEY=

# Where the notification goes: the email address of the Resend account (see above).
CONTACT_TO_EMAIL=

# Optional, only when NOT on Vercel: how many reverse proxies you run in front of `next start`,
# each appending the client address to X-Forwarded-For (e.g. 1 for a single nginx). The contact
# rate limit then keys on that entry (lib/rate-limit.ts). Unset/0: no IP header is trusted and all
# visitors share one bucket (5 messages/hour site-wide), because a client can set those headers
# itself. On Vercel this is ignored: the platform's own headers are used.
# TRUSTED_PROXY_HOPS=

# Optional, unset by default. Extra origins where the admin and the contact form should also work,
# comma-separated, at most 5, scheme + host only (e.g. https://www.example.com,https://name.vercel.app).
# Added to Payload's CSRF/CORS allowlist and the Turnstile hostname check (lib/origins.ts). Already
# included without it: NEXT_PUBLIC_SITE_URL, the Vercel production/deployment/branch URLs, and
# localhost when not on Vercel. An invalid entry fails loudly.
# EXTRA_ALLOWED_ORIGINS=

# --- Realtime (work plan 6.5/6.9, guide §10; optional) ---

# Optional. Ably API key ("appId.keyId:secret", free plan) for "N here now", live 👏 reactions on
# case studies and live cursors on Home. Realtime is OFF unless this is set when the site is BUILT
# (next.config.ts derives the NEXT_PUBLIC_REALTIME / NEXT_PUBLIC_REACTIONS flags from it; never set
# those yourself), so adding or removing it needs a rebuild. Reactions also need DATABASE_URI.
# Server only: browsers get 1-hour tokens from /api/realtime/token, never the key. Never prefix
# with NEXT_PUBLIC_. Setup: docs/ops/accounts.md section 9; quota: docs/ops/free-tier.md.
ABLY_API_KEY=

# --- Admin account (collections/Users.ts) ---

# Seed only (`npm run seed`, work plan 2.4): creates this admin user if no user exists yet. Leave both
# empty to skip. Use a real password manager entry; there is no default and nothing is logged.
# This is how the admin is created for a deployment: seed against Atlas before connecting the DB.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional, Vercel only. On a Vercel deployment (VERCEL_ENV set) nobody can create the first admin
# from the browser (/admin/create-first-user), even on an empty database. Set to 1 for one deploy to
# re-open it, then remove it. Local dev and `next start` are not affected.
# ALLOW_FIRST_USER=

# Password reset script only (`npm run admin:reset-password`, docs/admin-guide.md). Set them in the
# shell for one run; don't leave them in .env.local. The email can also be the first argument.
# RESET_ADMIN_EMAIL=
# RESET_ADMIN_PASSWORD=
