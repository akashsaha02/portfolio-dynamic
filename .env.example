# Copy to .env.local and fill in. Never commit real values.
# Every variable the app reads is listed here with a comment.

# Public base URL of the site, used for metadataBase (canonical and Open Graph URLs), see lib/seo.ts.
# Optional. When unset: on Vercel the system variables are used (production builds:
# https://$VERCEL_PROJECT_PRODUCTION_URL; previews: https://$VERCEL_URL); elsewhere
# http://localhost:$PORT (3000), and a production build prints a warning. An invalid URL fails the build.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Which template renders the public site: "editorial" (legacy v1 design) or "folio".
# Defaults to "editorial". Read on the server; static pages pick it up at build time, so
# rebuild after changing it. An unknown value fails the build. Phase 3 moves this to the
# Payload site-settings global.
SITE_TEMPLATE=editorial

# Optional, build time: output folder for next build/start (default .next). The e2e runner uses
# .next-folio for the Folio build so both templates can exist side by side.
# NEXT_DIST_DIR=.next-folio

# --- Payload CMS (admin at /admin, work plan 2.2) ---

# Required. Signs admin session tokens. A long random string, different per environment, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs the admin out. Server only: never prefix with NEXT_PUBLIC_.
PAYLOAD_SECRET=

# Required. MongoDB connection string. Production: MongoDB Atlas free cluster (guide §9.2), e.g.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority
# Local development: run `npm run dev:db` (throwaway in-memory MongoDB) and paste the URI it prints.
DATABASE_URI=

# Optional. Vercel Blob read-write token for media uploads (guide §9.2). Vercel sets it when a Blob
# store is connected to the project. When unset, uploads go to ./media on local disk (git-ignored),
# which only works locally: Vercel's file system is read-only.
BLOB_READ_WRITE_TOKEN=

# Seed only (`npm run seed`, work plan 2.4): creates this admin user if no user exists yet. Leave both
# empty to skip. Use a real password manager entry; there is no default and nothing is logged.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
